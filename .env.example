# Copia este archivo a .env.local. Sin estas variables la app arranca en modo demo.
# Solo van aquí valores PÚBLICOS: la anon key está pensada para el navegador (RLS protege los datos).
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
# Forzar modo demo aunque haya credenciales
VITE_DEMO_MODE=false

# Secretos de edge functions: NO van en este archivo. Se configuran con:
#   npx supabase secrets set ALLOWED_ORIGINS=https://app.tudominio.cl APP_URL=https://app.tudominio.cl
